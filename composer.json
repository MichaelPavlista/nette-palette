{
  "name": "pavlista/nette-palette",
  "description": "Palette support for Nette Framework and Latte template engine",
  "keywords": ["nette", "latte", "image", "thumbnail", "watermark", "gd", "imagick"],
  "homepage": "https://github.com/MichaelPavlista/nette-palette",
  "license": "MIT",
  "authors": [
    {
      "name": "Michael Pavlista",
      "homepage": "http://www.pavlista.cz/"
    }
  ],
  "require": {
    "php": ">=8.2 <8.5",
    "pavlista/palette": ">=v2.9.3 <3.0",
    "nette/di": "^3.1",
    "nette/utils": "^3 || ^4",
    "nette/application": "^3.1",
    "latte/latte": "^3"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpstan/phpstan-nette": "^1.3",
    "phpstan/phpstan-strict-rules": "^1.6",
    "phpstan/phpstan": "^1.11",
    "squizlabs/php_codesniffer": "^3.10.1",
    "joomla/coding-standards": "~3.0@alpha",
    "slevomat/coding-standard": "^8.15",
    "tracy/tracy": "^2.10.7"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
    "phpstan-baseline": "vendor/bin/phpstan analyse -c phpstan.neon --generate-baseline",
    "phpcs": "phpcs --standard=ruleset.xml src/ -s --colors -p --parallel=$(nproc --all)",
    "phpcs:summary": "phpcs --standard=ruleset.xml src/ -s --colors -p --report=summary --parallel=$(nproc --all)",
    "phpcs:fix": "phpcbf --standard=ruleset.xml src/ -s --colors -p --parallel=$(nproc --all)"
  },
  "autoload": {
    "classmap": ["src/"]
  }
}